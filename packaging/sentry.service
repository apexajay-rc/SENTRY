[Unit]
Description=SENTRY Pressure-Aware Resource Daemon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sentry
Environment="PYTHONPATH=/opt/sentry"

# Inject UID 1000 (maj-ajay) so the daemon knows who to give socket access to
Environment="SUDO_UID=1000"
Environment="SUDO_GID=1000"

# Execute exactly as if you ran it manually with sudo
ExecStart=/opt/sentry/venv/bin/python /opt/sentry/daemon/main.py

Restart=always
RestartSec=3

# Ensure open permissions on socket creation before the daemon chowns them
UMask=0000

[Install]
WantedBy=multi-user.target
