[Unit]
Description=SENTRY Desktop Spatial Bridge
Documentation=https://github.com/apexajay-rc/SENTRY
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/opt/sentry/venv/bin/python /opt/sentry/tools/desktop_bridge.py
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

# User-session security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes

# Access to Wayland/X11 sockets
Environment=XDG_RUNTIME_DIR=%t

[Install]
WantedBy=graphical-session.target